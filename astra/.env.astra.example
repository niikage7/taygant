# ── taygant · Astra Linux SE 1.8 «Воронеж» (ЗПС + PARSEC) ─────────────────────
#
# Скопируйте этот файл в $APP_ROOT/.env.astra и заполните:
#   mkdir -p ~/taygant && cp astra/.env.astra.example ~/taygant/.env.astra
# (APP_ROOT по умолчанию — ~/taygant; задаётся переменной APP_ROOT ниже.)

# Ключ подписи JWT-токенов (обязательно свой!):
#   openssl rand -hex 32
JWT_SECRET=please-change-me-openssl-rand-hex-32

# Организация (имя, которое попадёт в ключ подписи ЗПС, keys/gen-keys.sh).
TAYGANT_ORG_NAME=TAYGANT

# Пароль ключа подписи файлов ЗПС. Пустое значение = ключ без пароля.
SIGN_PASSPHRASE=

# Подписывать ли расширенные атрибуты (только для файлов на хосте,
# keys/sign-files.sh). Для образов всегда используется отсоединённая подпись.
SIGN_XATTR=0
SIGN_DETACHED=1

# Каталог развёртывания: ключи, подписанные ФС сервисов, данные БД.
# APP_ROOT=$HOME/taygant