# Настройки для docker compose. Для локального запуска:
#   cp .env.example .env
# и заполнить POSTGRES_PASSWORD и JWT_SECRET своими значениями — без них
# compose откажется стартовать (см. docker-compose.yml).

# Учётные данные Postgres. Сгенерируйте свой пароль, не используйте пример:
#   openssl rand -hex 24
POSTGRES_USER=taygant
POSTGRES_PASSWORD=
POSTGRES_DB=taygant

# JWT_SECRET — ключ подписи токенов входа. На сервере его задаёт CD из секрета
# GitHub JWT_SECRET. Свой ключ для локального запуска: openssl rand -hex 32
JWT_SECRET=

# Наполнять ли пустую БД демо-пользователями и демо-проектом при старте.
# По умолчанию выключено — приложение запускается пустым, как в проде.
# Включить для локальной демонстрации:
SEED_DEMO_DATA=false
